<mxfile host="app.diagrams.net" type="device">
  <diagram name="SPD-DANN-architecture" id="spddann-arch-1">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="SpectSPD-DANN: Spectral-Augmented SPD Domain-Adversarial Network  —  cross-dataset (LODO) depression detection" style="text;html=1;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="700" height="30" as="geometry" />
        </mxCell>

        <mxCell id="in" value="Raw EEG window&#10;17 ch x 500 samples  (4 s @ 125 Hz, harmonized 10-20 montage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="56" width="360" height="44" as="geometry" />
        </mxCell>

        <mxCell id="chdr" value="CONNECTIVITY STREAM  (Riemannian SPD)" style="text;html=1;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="110" y="120" width="300" height="22" as="geometry" />
        </mxCell>
        <mxCell id="shdr" value="SPECTRAL STREAM" style="text;html=1;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="650" y="120" width="280" height="22" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="Temporal Conv2d  (1 x 25)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="150" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Spatial Conv2d  (17 x 1)  ->  24 filters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="206" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Covariance Pool  ->  24 x 24 SPD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="262" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="BiMap  24 -> 12  (Stiefel weight)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="318" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="ReEig  (eigenvalue rectification)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="374" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="LogEig:  log(S)  ->  tangent  (12 x 12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="430" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="vspd" value="v_spd : 144-d tangent vector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#6c8ebf;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="170" y="490" width="180" height="34" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="Differential Entropy&#10;5 bands x 17 ch = 85-d  (per window)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="206" width="280" height="48" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="MLP  85 -> 64 -> 64  (ReLU)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="318" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="vde" value="v_de : 64-d embedding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e6;strokeColor=#82b366;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="700" y="430" width="180" height="34" as="geometry" />
        </mxCell>

        <mxCell id="fuse" value="Concatenate  [ v_spd  (+)  v_de ]&#10;fused tangent feature : 208-d" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="560" width="300" height="48" as="geometry" />
        </mxCell>

        <mxCell id="clf" value="Classifier&#10;Linear -> Softmax  ->  P(MDD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="650" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="grl" value="Gradient Reversal Layer  (x lambda_D, DANN schedule)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="630" width="300" height="34" as="geometry" />
        </mxCell>
        <mxCell id="disc" value="Domain Discriminator (MLP)&#10;->  { source , target }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="680" width="300" height="48" as="geometry" />
        </mxCell>

        <mxCell id="obj" value="Training objective (transductive):   L = L_C  +  L_D  +  L_M  +  lambda_P . L_P&#10;L_C = source cross-entropy (classifier)        L_D = domain-adversarial (discriminator via GRL)&#10;L_M = log-Euclidean mean alignment (source vs target SPD)        L_P = class-prototype pair loss on the FUSED feature (entropy-filtered target pseudo-labels)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="150" y="760" width="800" height="80" as="geometry" />
        </mxCell>

        <mxCell id="note" value="LODO setup: train on 2 SOURCE datasets (labeled) + held-out TARGET dataset (UNLABELED windows used at train time — no target labels). Prediction = mean P(MDD) over a subject's windows, averaged over a 4-seed ensemble (deep model is seed-sensitive at clinical N).&#10;ONE framework, TWO instantiations: CROSS-dataset (LODO) uses this LEARNED + adversarial model; WITHIN-dataset uses the FIXED shallow two-stream (= nrde, full NATIVE montage), because at clinical N (~50 subj/dataset) the learned encoder overfits (~0.64) and cannot match fixed Riemannian features (~0.72)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="150" y="852" width="800" height="72" as="geometry" />
        </mxCell>

        <mxCell id="results" value="MEASURED RESULTS — three regimes  (subject-level ROC-AUC; bal-acc/acc = leakage-free calibrated).&#10;1) Within-dataset 10-fold CV (native) — shallow nrde:  mean AUC 0.788   (MODMA 0.707 | Mumtaz 0.951 | OpenNeuro 0.705).&#10;2) Cross-dataset LODO (harmonized, 4-seed ensemble) — THIS model:  mean AUC 0.723   (MODMA 0.764 | Mumtaz 0.811 | OpenNeuro 0.594);  bal-acc MODMA 0.70 / Mumtaz 0.72.&#10;3) Pooled 10-fold CV (all 3 merged, N=232) — THIS model:  AUC 0.788, bal-acc 0.710, acc 0.716  (ALL >= 70%)  vs shallow nrde 0.745.&#10;Data-volume crossover: shallow wins small-N single dataset; THIS deep model wins pooled (N=232) AND cross-dataset LODO.  OpenNeuro fold capped by BDI-vs-clinical label shift." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="928" width="800" height="120" as="geometry" />
        </mxCell>

        <mxCell id="e_in_c1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="in" target="c1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_in_s1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="in" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_c1_c2" style="html=1;endArrow=block;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_c2_c3" style="html=1;endArrow=block;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_c3_c4" style="html=1;endArrow=block;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_c4_c5" style="html=1;endArrow=block;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_c5_c6" style="html=1;endArrow=block;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_c6_v" style="html=1;endArrow=block;" edge="1" parent="1" source="c6" target="vspd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_s1_s2" style="html=1;endArrow=block;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_s2_v" style="html=1;endArrow=block;" edge="1" parent="1" source="s2" target="vde"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_vspd_f" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="vspd" target="fuse"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_vde_f" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="vde" target="fuse"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_f_clf" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="fuse" target="clf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_f_grl" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="fuse" target="grl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_grl_disc" style="html=1;endArrow=block;" edge="1" parent="1" source="grl" target="disc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_clf_obj" style="html=1;endArrow=open;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="clf" target="obj"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_disc_obj" style="html=1;endArrow=open;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="disc" target="obj"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_c6_obj" style="html=1;endArrow=open;dashed=1;strokeColor=#b85450;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="c6" target="obj"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_f_obj" style="html=1;endArrow=open;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="fuse" target="obj"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
